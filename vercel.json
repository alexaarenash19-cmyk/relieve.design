{
  "rewrites": [
    { "source": "/api/collections", "destination": "/api/catalog?resource=collections" },
    { "source": "/api/pricing", "destination": "/api/catalog?resource=pricing" },
    { "source": "/api/waitlist", "destination": "/api/catalog?resource=waitlist" },
    { "source": "/api/places", "destination": "/api/catalog?resource=places" },
    { "source": "/api/places/:slug", "destination": "/api/catalog?resource=places&slug=:slug" },
    { "source": "/api/orders/:token", "destination": "/api/catalog?resource=orders&token=:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
